{
  "version": 5,
  "cmakeMinimumRequired": {"major": 3, "minor": 24, "patch": 0},
  "configurePresets": [
    {
      "name": "sdk-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/sdk-release",
      "toolchainFile": "${sourceDir}/cmake/TI-Nspire-Toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/release"
      }
    },
    {
      "name": "sdk-debug",
      "inherits": "sdk-release",
      "binaryDir": "${sourceDir}/build/sdk-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/debug"
      }
    },
    {
      "name": "windows-release",
      "inherits": "sdk-release",
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"},
      "binaryDir": "${sourceDir}/build/windows-release",
      "cacheVariables": {
        "Python3_EXECUTABLE": "${sourceDir}/.venv/Scripts/python.exe",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/windows-release",
        "CMAKE_FIND_USE_PACKAGE_REGISTRY": false,
        "CMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY": false
      }
    },
    {
      "name": "windows-debug",
      "inherits": "windows-release",
      "binaryDir": "${sourceDir}/build/windows-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/windows-debug"
      }
    }
  ],
  "buildPresets": [
    {"name": "sdk-release", "configurePreset": "sdk-release"},
    {"name": "sdk-debug", "configurePreset": "sdk-debug"},
    {"name": "windows-release", "configurePreset": "windows-release"},
    {"name": "windows-debug", "configurePreset": "windows-debug"}
  ]
}
